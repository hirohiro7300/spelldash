{
  "git": {
    "deploymentEnabled": {
      "claude/spelldash-dev-strategy-wzjixj": false
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "spelldash.vercel.app"
        }
      ],
      "destination": "https://www.spelldash.net/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "spelldash-jzf8.vercel.app"
        }
      ],
      "destination": "https://www.spelldash.net/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "spelldash.net"
        }
      ],
      "destination": "https://www.spelldash.net/:path*",
      "permanent": true
    },
    {
      "source": "/packs",
      "destination": "/?from=old",
      "permanent": false
    },
    {
      "source": "/packs/:path*",
      "destination": "/?from=old",
      "permanent": false
    },
    {
      "source": "/list.html",
      "destination": "/?from=old",
      "permanent": false
    },
    {
      "source": "/typing.html",
      "destination": "/?from=old",
      "permanent": false
    },
    {
      "source": "/typing-game.html",
      "destination": "/?from=old",
      "permanent": false
    },
    {
      "source": "/battle.html",
      "destination": "/?from=old",
      "permanent": false
    }
  ],
  "crons": [
    { "path": "/api/cron/keepalive", "schedule": "0 20 * * *" }
  ],
  "functions": {
    "api/generate-cards.js": {
      "maxDuration": 60
    },
    "api/explain-word.js": {
      "maxDuration": 30
    },
    "api/admin/players.js": {
      "maxDuration": 30
    },
    "api/billing/webhook.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-cN5Qpxi7RwFUpbDWByYR19AX89L4ayF7dtrA+cc5pzE=' 'sha256-bU3LyKmeJJNC7VwS0gE/ZCRvNCvlrtp3RR4PbqYh6E0=' 'sha256-/AF4pOXSvjQRRjy0hK3rcbaM6E/oMgyo5BRluouhliU=' 'sha256-dM+h40Uv9WuXVV3X/rS9T2CInDSqD+vQROgZJnfXkgc=' 'sha256-lSv9O21CkV2nIG7oWatbYYqW4PmD/YQhswycK4PxRoE=' 'sha256-KK+YdbE+hhLXNYzHMqc0KD7S/3vGQGtR3JeOQTQUsj8=' 'sha256-T7/IRZpA/Fx9/G5GMAeW2kNIdG/opSpYonqUT7Lv7gw=' 'sha256-o5e3GXLVFzE3w/WGzjdhAHl99+Z6BbHXBsgPfLCm+To=' 'sha256-mKYHMij9fRGvk7wqteoJEyNMpQ6r72TEbsDIsudP1Y4=' 'sha256-Lge+Z+K9IKc0R6hvKJm2jS5P8SgefpB5HFQqV2zFQoo=' 'sha256-wELjbqMBsrXfg4n5aawdDfnls4zfdIJZwNsasvr0qlg=' 'sha256-6UyYZaCzx4JljhrMBlyQsvgtFkmmD4oWtZII2I1n4rM=' 'sha256-uqbmNLhDpfM+hL1yfJZGZtTvbXspSfZ6jTcsVa2uPQ4=' 'sha256-KK+ubQHD4V0kbOTNz5O9gdkIvychTswsCXVnH0ZNlG4=' https://esm.sh; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://esm.sh https://sujvgwozsnzjsjmkcrnk.supabase.co wss://sujvgwozsnzjsjmkcrnk.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
