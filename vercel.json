{
  "git": {
    "deploymentEnabled": {
      "claude/spelldash-dev-strategy-wzjixj": false
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "spelldash.vercel.app" }],
      "destination": "https://www.spelldash.net/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "spelldash-jzf8.vercel.app" }],
      "destination": "https://www.spelldash.net/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "spelldash.net" }],
      "destination": "https://www.spelldash.net/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/generate-cards.js": { "maxDuration": 60 },
    "api/explain-word.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://esm.sh https://sujvgwozsnzjsjmkcrnk.supabase.co wss://sujvgwozsnzjsjmkcrnk.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
