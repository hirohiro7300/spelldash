{
  "appId": "net.spelldash.app",
  "appName": "SpellDash",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#F4ECDA",
    "preferredContentMode": "mobile"
  },
  "android": {
    "backgroundColor": "#F4ECDA",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#1A2137",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1A2137"
    }
  }
}
